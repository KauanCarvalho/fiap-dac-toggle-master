# ==========================================================
# PRODUCTION CONFIG (REQUIRED CHANGES)
# ==========================================================
# YOU MUST UPDATE THESE VALUES IN PRODUCTION
# DO NOT INCLUDE QUOTES ("") IN VALUES
# DO NOT LEAVE TRAILING SPACES

# Base ingress URL (no trailing slash)
INGRESS_URL=http://...

# Service endpoints (derived from ingress)
AUTH_SERVICE_URL=${INGRESS_URL}/auth
FLAG_SERVICE_URL=${INGRESS_URL}/flags
TARGETING_SERVICE_URL=${INGRESS_URL}/targeting
EVALUATION_SERVICE_URL=${INGRESS_URL}/evaluate
ANALYTICS_SERVICE_URL=${INGRESS_URL}/analytics

# API KEYS
EVALUATION_SERVICE_API_KEY=eval_api_key
FLAG_SERVICE_API_KEY=eval_api_key
TARGETING_SERVICE_API_KEY=eval_api_key

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_SESSION_TOKEN=REPLACE_ME
